# --- Phase 0 (health scaffold) ---
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0
# 0 local, 1 on Render (behind a proxy)
TRUST_PROXY=0
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:3000

# storage: local (dev/CI, files under apps/api/.data) or supabase
STORAGE_PROVIDER=local
# extraction: mock (dev/CI) or gemini
EXTRACT_PROVIDER=mock
# ocr text layer: none (dev/CI) or typhoon
OCR_PROVIDER=none

# --- W2: database + auth + encryption ---
# Supabase Session pooler URI (port 5432), NOT the IPv6 direct URI:
# postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# set to "disable" for local docker Postgres
PGSSL=disable
JWT_SECRET=
# 32-byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENC_KEY=

# --- W2: storage (STORAGE_PROVIDER=supabase) ---
# Supabase dashboard -> Project Settings -> API: copy the "Project URL" and the
# "service_role" secret (NOT the anon key: service_role bypasses RLS and must only
# ever live on the API server). Under Storage, create a PRIVATE bucket with the
# SUPABASE_BUCKET name first. The API calls storage/v1 over REST (no supabase-js);
# with STORAGE_PROVIDER=local the three values below are ignored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=records

# --- W3: AI (EXTRACT_PROVIDER=gemini, OCR_PROVIDER=typhoon) ---
# Both free tiers may use what you send to improve their models (Google: "do not submit
# sensitive, confidential, or personal information"; SCB 10X collects usage data), so
# send SYNTHETIC documents only, never real patient records. Leave the keys empty to
# keep the deterministic mock extractor (dev/CI).
#
# Gemini: Google AI Studio -> Get API key (aistudio.google.com, no card). EXTRACT_PROVIDER=gemini
# only takes effect when GEMINI_API_KEY is set; without it (or if Gemini fails after
# retries) the API serves the mock result labelled source=mock plus a warning code.
# Real free-tier limits are only shown at aistudio.google.com/rate-limit.
GEMINI_API_KEY=
# any free-tier vision model id; 2.5-flash-lite has the highest reported daily quota
GEMINI_MODEL=gemini-2.5-flash-lite
# Typhoon OCR (optional text layer handed to Gemini as extra context): sign up at
# playground.opentyphoon.ai -> API Keys (free, 20 requests/min on typhoon-ocr; 429 is
# retried). Needs OCR_PROVIDER=typhoon; if OCR fails the extraction still runs on the
# image alone and returns warning "ocr_unavailable".
TYPHOON_API_KEY=

# --- W3-W4: alert email ---
RESEND_API_KEY=
# without a verified domain, Resend delivers only to the account owner's address
ALERT_EMAIL_TO=
RESEND_FROM=onboarding@resend.dev

# --- seed demo user (db/seed.ts) ---
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
SEED_DEMO_PIN=
