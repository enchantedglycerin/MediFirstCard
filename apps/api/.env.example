# MediFirstCard API configuration
#
# HOW TO USE
#   1. cp apps/api/.env.example apps/api/.env      (.env is gitignored - never commit it)
#   2. Fill PART A (two secrets). The API then runs fully offline: embedded PostgreSQL,
#      local-disk storage, deterministic mock extractor.
#   3. Fill PART B only when you have the cloud accounts. Leave a value EMPTY to keep the
#      local/mock behaviour - do not paste the "<...>" placeholders literally.
#
# Placeholder format: <like-this> = replace the whole thing including the angle brackets.

# ============================================================================
# PART A - required for every run (local, CI, demo)
# ============================================================================
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0
# 0 on a laptop, 1 on Render (behind a proxy)
TRUST_PROXY=0
CORS_ORIGINS=*
# The URL phones and QR scanners use to reach THIS server. Laptop demo: your Wi-Fi IPv4
# (ipconfig), e.g. http://192.168.1.20:3000 - Render: https://<service>.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Secret used to sign login tokens. Any long random string (32+ chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Example (do NOT reuse): JWT_SECRET=1sOZbq0v9yA1p9c5pZ8u2f+uxg0qLh8xZ1cHl4G2j2c=
JWT_SECRET=<32-byte-random-base64>

# Key that encrypts every health-content column (AES-256-GCM). MUST be exactly 32 random
# bytes in base64 (44 characters ending in "="). Generate with the same node command.
# Losing this key makes all stored health data unreadable - keep a copy somewhere safe.
# Example (do NOT reuse): FIELD_ENC_KEY=Q3Vhc2tkZmpza2RmanNrZGZqc2tkZmpza2RmanNrZGY=
FIELD_ENC_KEY=<32-byte-random-base64>

# ============================================================================
# PART B - cloud services (optional; empty = local / mock)
# ============================================================================

# ---- B1. Database (Supabase PostgreSQL) ------------------------------------
# Empty  -> embedded PGlite database on disk at apps/api/.data/pg (no account needed).
# Filled -> Supabase dashboard -> click the green "Connect" button at the TOP of the
#           project page (next to the project name) -> tab "Session pooler" (port 5432;
#           works on IPv4-only networks such as home Wi-Fi and Render) -> copy the URI and
#           replace [YOUR-PASSWORD] with the database password you set at project creation.
#           (Settings -> Database only has the password reset now, not the string.)
# Shape:    postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# "require" for Supabase, "disable" for docker-compose Postgres on your own machine
PGSSL=require

# ---- B2. Document image storage (Supabase Storage) --------------------------
# STORAGE_PROVIDER=local    -> files under apps/api/.data/records (no account needed)
# STORAGE_PROVIDER=supabase -> needs the three SUPABASE_* values below
STORAGE_PROVIDER=local
# Supabase dashboard -> Settings -> API -> "Project URL"
# Shape:  https://<project-ref>.supabase.co
SUPABASE_URL=
# Same page -> "service_role" secret (NOT the anon/public key; service_role bypasses RLS
# and must only ever live on this server). Starts with "eyJ" or "sb_secret_".
# Shape:  eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<long-string>
SUPABASE_SERVICE_ROLE_KEY=
# Storage -> New bucket -> name "records", PRIVATE. Create it before switching providers.
SUPABASE_BUCKET=records

# ---- B3. AI document extraction (Google Gemini + SCB 10X Typhoon) -----------
# Both free tiers may use what you send to improve their models (Google: "do not submit
# sensitive, confidential, or personal information"). Send SYNTHETIC documents only
# (docs/samples), never real patient records.
#
# EXTRACT_PROVIDER=mock   -> deterministic example result (dev, CI, demo fallback)
# EXTRACT_PROVIDER=gemini -> live; only takes effect when GEMINI_API_KEY is set.
#                            If Gemini fails after retries the API serves the mock result
#                            labelled source=mock with warning "ai_provider_unavailable".
EXTRACT_PROVIDER=mock
# Google AI Studio -> https://aistudio.google.com/app/apikey -> Create API key (no card)
# Shape:  AIzaSy<33-more-characters>
GEMINI_API_KEY=
# Any free-tier vision model id; 2.5-flash-lite has the highest reported daily quota
GEMINI_MODEL=gemini-3.5-flash-lite
#
# OCR_PROVIDER=none    -> Gemini reads the image alone
# OCR_PROVIDER=typhoon -> Typhoon OCR transcribes Thai text first and hands it to Gemini
#                         as extra context (better Thai accuracy; 20 requests/min limit)
OCR_PROVIDER=none
# https://playground.opentyphoon.ai -> API Keys -> Create (free, no card)
# Shape:  sk-<long-string>
TYPHOON_API_KEY=

# ---- B4. Alert e-mail (Resend) - optional, in-app alerts work without it ----
# https://resend.com -> API Keys (free, no card). With a key, every alert (card viewed,
# link opened, link revoked) is ALSO e-mailed to the owner's account address.
# ALERT_EMAIL_TO is an OVERRIDE for the free tier: without a verified domain Resend only
# delivers to the account owner's own address, so put that address here for demos and
# leave it empty once a domain is verified (then each user gets mail at their own address).
# Shape:  re_<long-string>
RESEND_API_KEY=
ALERT_EMAIL_TO=
RESEND_FROM=onboarding@resend.dev

# ---- B5. Seed demo user (optional, db/seed.ts) -------------------------------
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
SEED_DEMO_PIN=

# ============================================================================
# PART C - Render (cloud hosting of this API). Nothing to fill in here.
# ============================================================================
# This .env file is NOT used on Render. Deploy with the Blueprint in render.yaml
# (see docs/deploy-render.md): Render creates the service and asks you to paste the
# secrets from PART A/B once. Render itself provides:
#   PORT                 - the port to listen on (the API reads it automatically)
#   RENDER_EXTERNAL_URL  - https://<service>.onrender.com, used as PUBLIC_BASE_URL
# and render.yaml fixes NODE_ENV=production, TRUST_PROXY=1, PGSSL=require, the provider
# switches and GEMINI_MODEL. After deploying, point the phone at the Render URL
# (More -> Developer -> Server URL) unless the release build already defaults to it.
